rules_version = '2';

// Every read/write in this app goes through the Streamlit backend using the
// Firebase Admin SDK, which bypasses these rules entirely. There is no
// browser/mobile client talking to Firestore directly. So the only thing
// these rules need to do is deny any direct client access - if someone
// gets hold of a client API key and tries to hit Firestore straight from
// a browser, the request should fail here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
